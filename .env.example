# Скопируй в .env.local для локальной разработки.
# На Vercel эти же имена впиши в Project Settings -> Environment Variables.

# Токен от @BotFather (команда /newbot)
TELEGRAM_BOT_TOKEN=

# Придумай длинную случайную строку — она прячет адрес вебхука от чужих запросов
TELEGRAM_WEBHOOK_SECRET=

# Ещё одна случайная строка — защищает одноразовый эндпоинт регистрации вебхука
SETUP_KEY=

# Доверенный HTTPS origin для первоначальной регистрации вебхука (без пути).
# На Vercel при отсутствии APP_URL используется системная VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=

# Строка подключения к базе Neon (Settings -> Connection string, режим "Pooled connection")
DATABASE_URL=

# Ключ OpenAI — используется и для распознавания голоса (Whisper),
# и для разбора смысла фразы (GPT-4o-mini). Один ключ на всё.
OPENAI_API_KEY=

# Секрет для защиты эндпоинта напоминаний, вызываемого GitHub Actions
CRON_SECRET=

# Фиксированное смещение часового пояса бота. Москва не переходит на летнее время,
# поэтому просто константа. Для Даланга — "+07:00", для Перми — "+05:00".
DEFAULT_TZ_OFFSET=+03:00

# Реквизиты для публичной страницы /plus. Заполняются в настройках сервера.
PLUS_SELLER_NAME=
PLUS_SELLER_INN=
PLUS_SELLER_OGRNIP=
PLUS_SUPPORT_EMAIL=
PLUS_SUPPORT_PHONE=

# После применения migrations/002-plus-plans.sql включите проверку лимитов.
PLUS_PLANS_ENABLED=0
# Telegram ID владельца. Бот показывает его владельцу по /myid в личном чате.
PLUS_ADMIN_TELEGRAM_ID=
# Имя бота без @ для ссылок рекламных кампаний. По умолчанию используется бот проекта.
PLUS_BOT_USERNAME=


# Адрес веб-планировщика и Auth проекта. В Preview используйте отдельный проект и базу.
WEB_PLANNER_ORIGIN=
WEB_PLANNER_PUBLIC_READY=0
WEB_PLANNER_DATABASE_URL=
WEB_SUPABASE_URL=
WEB_SUPABASE_PUBLISHABLE_KEY=
WEB_PLANNER_DATABASE_CA=
WEB_PLANNER_TEST_EMAIL=
WEB_PLANNER_TEST_DATABASE_URL=
WEB_TELEGRAM_LINK=0

WEB_YOOKASSA_MODE=
WEB_YOOKASSA_LIVE_APPROVED=0
WEB_YOOKASSA_CHECKOUT_PAUSED=1
WEB_YOOKASSA_SHOP_ID=
WEB_YOOKASSA_SECRET_KEY=
WEB_YOOKASSA_HOOK_KEY=
WEB_YOOKASSA_VAT_CODE=
WEB_YOOKASSA_PAYMENT_SUBJECT=
WEB_YOOKASSA_PAYMENT_MODE=
