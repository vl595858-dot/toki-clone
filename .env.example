# Скопируй в .env.local для локальной разработки.
# На Vercel эти же имена впиши в Project Settings -> Environment Variables.

# Токен от @BotFather (команда /newbot)
TELEGRAM_BOT_TOKEN=

# Придумай длинную случайную строку — она прячет адрес вебхука от чужих запросов
TELEGRAM_WEBHOOK_SECRET=

# Ещё одна случайная строка — защищает одноразовый эндпоинт регистрации вебхука
SETUP_KEY=

# Строка подключения к базе Neon (Settings -> Connection string, режим "Pooled connection")
DATABASE_URL=

# Ключ OpenAI — используется и для распознавания голоса (Whisper),
# и для разбора смысла фразы (GPT-4o-mini). Один ключ на всё.
OPENAI_API_KEY=

# Секрет для защиты эндпоинта напоминаний, вызываемого GitHub Actions
CRON_SECRET=

# Фиксированное смещение часового пояса бота. Москва не переходит на летнее время,
# поэтому просто константа. Для Даланга — "+07:00", для Перми — "+05:00".
DEFAULT_TZ_OFFSET=+03:00
